# ============================================================
#  WireGuard Client — Environment Configuration
#  Semua setting ephemeral: hanya aktif saat container hidup
# ============================================================

# --- Interface ---
WG_INTERFACE=wg-mikrotik
WG_MTU=1412
WG_KEEPALIVE=25

# --- Tunnel IP untuk VM ini (dari subnet 100.10.11.0/24) ---
# Ganti sesuai IP yang di-assign server untuk client ini
WG_CLIENT_IP=100.10.11.2

# --- Key Client (generate: wg genkey | tee privatekey | wg pubkey > publickey) ---
WG_CLIENT_PRIVATE_KEY=4Bo9niQEQ5T9+LbPEVhdAmkgyUiaPzRxg40w+T0Mwmk=

# --- Key & Endpoint Server WireGuard (MikroTik/server) ---
WG_SERVER_PUBLIC_KEY=ykYMzUd5GSsAWPhr2kUvVb/POcSaxx9peQOkcCXzwUQ=
WG_SERVER_ENDPOINT=38.47.94.143
WG_SERVER_PORT=51820

# --- Subnet tunnel yang diizinkan melewati interface ---
# 100.10.11.0/24 = seluruh tunnel peer
WG_ALLOWED_IPS=100.10.11.0/24

# --- Jaringan lokal di belakang VM ini (untuk routing & NAT) ---
# Interface: ens19=172.16.1.x | ens20=172.16.2.x | ens21=172.16.4.x | ens22=172.16.5.x
LOCAL_NET_1=172.16.1.0/24
LOCAL_NET_2=172.16.2.0/24
LOCAL_NET_3=172.16.3.0/24
LOCAL_NET_4=172.16.4.0/24
LOCAL_NET_5=172.16.5.0/24

# Interface fisik LAN (sesuaikan dengan ip a)
LAN_IFACE_1=ens19
LAN_IFACE_2=ens20
LAN_IFACE_3=ens21
LAN_IFACE_4=ens22
