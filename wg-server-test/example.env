# ============================================================
#  WireGuard Server - Environment Configuration
# ============================================================

# --- Pengaturan Interface Server ---
WG_INTERFACE=wg-server-test
WG_LISTEN_PORT=51820
WG_MTU=1412

# IP Address untuk server di dalam tunnel (beserta subnet mask)
WG_SERVER_IP=100.10.11.1/24

# Subnet keseluruhan untuk NAT iptables
WG_SUBNET=100.10.11.0/24

# Interface fisik host yang terhubung ke internet/LAN (cek dengan perintah 'ip a' di host, misal: eth0, ens18)
HOST_PUBLIC_IFACE=eth0

# --- Private Key Server ---
# Generate di host dengan: wg genkey
WG_SERVER_PRIVATE_KEY=Isi_Dengan_Private_Key_Server_Di_Sini

# ============================================================
# Konfigurasi Peer (Client)
# ============================================================

# --- Client 1 ---
# Public key dari client yang sudah di-generate
WG_PEER1_PUBLIC_KEY=Isi_Dengan_Public_Key_Client_Di_Sini
# IP tunnel yang dialokasikan khusus untuk client ini (gunakan /32)
WG_PEER1_ALLOWED_IPS=100.10.11.2/32