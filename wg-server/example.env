# ============================================================
# WireGuard Server - Ephemeral Docker Setup
# Host target: Ubuntu 22.04
# Mode: host network, tanpa privileged: true
# ============================================================

# ------------------------------------------------------------
# Interface WireGuard
# ------------------------------------------------------------
WG_INTERFACE=wg-server
WG_SERVER_IP=100.10.11.1
WG_SERVER_CIDR=24
WG_SERVER_PORT=51820
WG_MTU=1412

# Private key server.
# Generate dengan:
#   ./generate-keys.sh
WG_SERVER_PRIVATE_KEY=ISI_PRIVATE_KEY_SERVER

# ------------------------------------------------------------
# IP Forwarding
# ------------------------------------------------------------
# 1 = entrypoint akan mengaktifkan ip_forward secara ephemeral.
#     Saat container stop, nilai awal host akan dikembalikan.
# 0 = entrypoint hanya cek status ip_forward host.
WG_ENABLE_IPV4_FORWARD=1

# ------------------------------------------------------------
# Firewall / iptables
# ------------------------------------------------------------
# Interface WAN/public tempat UDP WireGuard listen.
# Kosongkan agar rule INPUT UDP tidak dibatasi interface.
# Contoh: eth0, ens18, enp0s3
WAN_IFACE=

# 1 = buka UDP WG_SERVER_PORT via iptables secara ephemeral.
# 0 = jangan tambah rule INPUT UDP.
WG_OPEN_FIREWALL_PORT=1

# 1 = izinkan forwarding dari/ke interface WireGuard.
WG_ENABLE_FORWARD_RULES=1

# ------------------------------------------------------------
# NAT
# ------------------------------------------------------------
# Default 0 agar server tidak mengubah koneksi host.
# Aktifkan hanya jika server ini memang harus menjadi gateway NAT
# untuk peer WireGuard keluar ke WAN/LAN tertentu.
WG_ENABLE_NAT=0

# Interface tujuan NAT.
# Contoh: eth0
NAT_OUT_IFACE=eth0

# Source subnet yang di-NAT jika WG_ENABLE_NAT=1.
NAT_SOURCE_CIDR=100.10.11.0/24

# ------------------------------------------------------------
# Peer 1 - contoh: wg-client dari VM tunnel-wg-client
# ------------------------------------------------------------
PEER1_NAME=tunnel-wg-client

# Public key client.
# Dari cat client_publickey.
PEER1_PUBLIC_KEY=52vDoxhLW3ApfikAizZo6ykKMBut/GSWCbUAaDEvvHo=

# Allowed IPs peer.
# Untuk server hub:
# - IP tunnel peer: 100.10.11.2/32
# - LAN di belakang peer: 172.16.x.0/24
#
# Route ke prefix ini akan dibuat manual oleh entrypoint.
# 0.0.0.0/0 sengaja akan di-skip agar tidak merusak default route host.
PEER1_ALLOWED_IPS=100.10.11.2/32,172.16.1.0/24,172.16.2.0/24,172.16.3.0/24,172.16.4.0/24,172.16.5.0/24

# Optional.
PEER1_PERSISTENT_KEEPALIVE=25

# ------------------------------------------------------------
# Peer 2 - optional
# Kosongkan jika tidak dipakai
# ------------------------------------------------------------
PEER2_NAME=
PEER2_PUBLIC_KEY=
PEER2_ALLOWED_IPS=
PEER2_PERSISTENT_KEEPALIVE=25

# ------------------------------------------------------------
# Peer 3 - optional
# ------------------------------------------------------------
PEER3_NAME=
PEER3_PUBLIC_KEY=
PEER3_ALLOWED_IPS=
PEER3_PERSISTENT_KEEPALIVE=25

# ------------------------------------------------------------
# Peer 4 - optional
# ------------------------------------------------------------
PEER4_NAME=
PEER4_PUBLIC_KEY=
PEER4_ALLOWED_IPS=
PEER4_PERSISTENT_KEEPALIVE=25

# ------------------------------------------------------------
# Peer 5 - optional
# ------------------------------------------------------------
PEER5_NAME=
PEER5_PUBLIC_KEY=
PEER5_ALLOWED_IPS=
PEER5_PERSISTENT_KEEPALIVE=25